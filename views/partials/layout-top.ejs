<body data-page="<%= page.active %>">
  <a class="skip-link" href="#main">Lewati ke konten utama</a>
  <div class="app-shell">
    <%- include('sidebar') %>
    <button type="button" class="sidebar-backdrop" data-sidebar-close aria-label="Tutup menu" hidden></button>
    <div class="app-body">
      <%- include('topbar') %>
      <main id="main" class="main" tabindex="-1">
        <noscript>
          <div class="notice notice--warning">
            <span>JavaScript nonaktif. Navigasi dan formulir tetap dapat digunakan, tetapi menu mobile dan dialog konfirmasi memerlukan JavaScript.</span>
          </div>
        </noscript>
        <%- include('flash') %>
