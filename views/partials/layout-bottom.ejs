      </main>
      <footer class="app-footer">
        <span>SPK Kinerja Pegawai, <%= currentYear %>. Metode TOPSIS.</span>
        <span>Data awal adalah simulasi akademik, bukan data instansi nyata.</span>
      </footer>
    </div>
  </div>

  <dialog id="confirm-dialog" class="dialog" aria-labelledby="confirm-title">
    <form id="confirm-form" method="post" action="">
      <div class="dialog__header">
        <h2 class="dialog__title" id="confirm-title">Konfirmasi tindakan</h2>
      </div>
      <div class="dialog__body">
        <p id="confirm-message"></p>
      </div>
      <div class="dialog__footer">
        <button type="button" class="btn btn--secondary" data-dialog-cancel>Batal</button>
        <button type="submit" class="btn btn--primary" id="confirm-submit">Lanjutkan</button>
      </div>
    </form>
  </dialog>

  <script type="module" src="/js/app.js"></script>
</body>
</html>
