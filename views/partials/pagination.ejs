<% if (pagination && pagination.totalPages > 1) { %>
  <nav class="pagination" aria-label="Navigasi halaman">
    <p class="mb-0">Menampilkan <%= pagination.from %> sampai <%= pagination.to %> dari <%= pagination.total %> data</p>
    <div class="pagination__pages">
      <% if (pagination.previousUrl) { %>
        <a class="pagination__link" href="<%= pagination.previousUrl %>">Sebelumnya</a>
      <% } %>
      <% pagination.pages.forEach(function (item) { %>
        <% if (item.gap) { %>
          <span class="pagination__gap">...</span>
        <% } else if (item.current) { %>
          <span class="pagination__link" aria-current="page"><%= item.number %></span>
        <% } else { %>
          <a class="pagination__link" href="<%= item.url %>"><%= item.number %></a>
        <% } %>
      <% }); %>
      <% if (pagination.nextUrl) { %>
        <a class="pagination__link" href="<%= pagination.nextUrl %>">Berikutnya</a>
      <% } %>
    </div>
  </nav>
<% } %>
